{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "User",
  "description": "User Document Schema defined in RF-backend (MongoDB / Mongoose)",
  "type": "object",
  "properties": {
    "_id": {
      "type": "string",
      "description": "MongoDB ObjectId",
      "example": "64f1a2b3c4d5e6f7a8b9c0d1"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "User email address (required, unique, indexed)",
      "required": true
    },
    "fullName": {
      "type": "string",
      "description": "Full name of the user (required)",
      "required": true,
      "minLength": 3,
      "maxLength": 50
    },
    "password": {
      "type": "string",
      "description": "Hashed password (select: false in queries)",
      "minLength": 6,
      "maxLength": 128
    },
    "followersCount": {
      "type": "integer",
      "default": 0,
      "description": "Total number of followers"
    },
    "followingCount": {
      "type": "integer",
      "default": 0,
      "description": "Total number of users followed"
    },
    "profile": {
      "type": "object",
      "description": "User profile details",
      "properties": {
        "bio": {
          "type": "string",
          "maxLength": 300,
          "description": "Short bio or description"
        },
        "avatar": {
          "type": "string",
          "format": "uri",
          "description": "Avatar image URL"
        },
        "cover": {
          "type": "string",
          "format": "uri",
          "description": "Cover banner image URL"
        },
        "website": {
          "type": "string",
          "format": "uri",
          "description": "Personal or portfolio website URL"
        },
        "profession": {
          "type": "string",
          "description": "User's current profession/title"
        },
        "location": {
          "type": "string",
          "description": "Location (City, Country)"
        },
        "availableForHire": {
          "type": "boolean",
          "description": "Whether user is available for hiring"
        },
        "social": {
          "type": "object",
          "description": "Social media links",
          "properties": {
            "facebook": {
              "type": "string",
              "format": "uri"
            },
            "twitter": {
              "type": "string",
              "format": "uri"
            },
            "instagram": {
              "type": "string",
              "format": "uri"
            },
            "linkedin": {
              "type": "string",
              "format": "uri"
            },
            "github": {
              "type": "string",
              "format": "uri"
            }
          }
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when record was created"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when record was last updated"
    }
  },
  "required": [
    "email",
    "fullName"
  ]
}
